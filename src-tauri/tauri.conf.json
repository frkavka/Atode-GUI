{
  "productName": "Atode",
  "version": "0.0.1",
  "identifier": "com.atode.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Atode",
        "width": 1000,
        "height": 700,
        "visible": false,
        "alwaysOnTop": false,
        "closable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.ico"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "app", "dmg"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "src/scripts/windows_get_url.ps1"
    ]
  }
}